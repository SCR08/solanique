{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "useRootPaddingAwareAlignments": true,
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "slug": "solanique-black",
          "name": "Solanique Black",
          "color": "#040404"
        },
        {
          "slug": "graphite",
          "name": "Graphite",
          "color": "#0b0d10"
        },
        {
          "slug": "graphite-soft",
          "name": "Graphite Soft",
          "color": "#111318"
        },
        {
          "slug": "surface-elevated",
          "name": "Surface Elevated",
          "color": "#14161c"
        },
        {
          "slug": "titanium",
          "name": "Titanium",
          "color": "#a8a8a8"
        },
        {
          "slug": "platinum",
          "name": "Platinum",
          "color": "#d7d3c8"
        },
        {
          "slug": "silver",
          "name": "Silver",
          "color": "#ebe7dc"
        },
        {
          "slug": "champagne-accent",
          "name": "Champagne Accent",
          "color": "#d8c58e"
        },
        {
          "slug": "antique-gold",
          "name": "Antique Gold",
          "color": "#b0924f"
        }
      ]
    },
    "layout": {
      "contentSize": "48rem",
      "wideSize": "80rem"
    },
    "spacing": {
      "customSpacingSize": false,
      "defaultSpacingSizes": false,
      "spacingScale": {
        "steps": 0
      },
      "spacingSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.5rem"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "0.75rem"
        },
        {
          "slug": "md",
          "name": "MD",
          "size": "1rem"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "1.5rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "2rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "3rem"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "4rem"
        },
        {
          "slug": "4xl",
          "name": "4XL",
          "size": "6rem"
        }
      ],
      "units": [
        "px",
        "rem",
        "%"
      ]
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "fluid": true,
      "fontFamilies": [
        {
          "slug": "base",
          "name": "Base Sans",
          "fontFamily": "\"Helvetica Neue\", Helvetica, Arial, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, \"Segoe UI\", sans-serif"
        },
        {
          "slug": "heading",
          "name": "Solanique Heading",
          "fontFamily": "Cinzel, \"Times New Roman\", Times, serif"
        },
        {
          "slug": "mono",
          "name": "Mono",
          "fontFamily": "ui-monospace, \"SFMono-Regular\", Consolas, \"Liberation Mono\", monospace"
        }
      ],
      "fontSizes": [
        {
          "slug": "xs",
          "name": "XS",
          "size": "0.8125rem"
        },
        {
          "slug": "sm",
          "name": "SM",
          "size": "0.9375rem"
        },
        {
          "slug": "md",
          "name": "MD",
          "size": "1.0625rem"
        },
        {
          "slug": "lg",
          "name": "LG",
          "size": "1.25rem"
        },
        {
          "slug": "xl",
          "name": "XL",
          "size": "1.5rem"
        },
        {
          "slug": "2xl",
          "name": "2XL",
          "size": "1.95rem"
        },
        {
          "slug": "3xl",
          "name": "3XL",
          "size": "2.5rem"
        }
      ],
      "lineHeight": true
    }
  },
  "styles": {
    "color": {
      "background": "#040404",
      "text": "#d7d3c8"
    },
    "elements": {
      "button": {
        "color": {
          "background": "#ebe7dc",
          "text": "#040404"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|base"
        }
      },
      "heading": {
        "color": {
          "text": "#ebe7dc"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
      },
      "link": {
        "color": {
          "text": "#ebe7dc"
        }
      }
    },
    "blocks": {
      "core/button": {
        "border": {
          "radius": "0"
        },
        "color": {
          "background": "#ebe7dc",
          "text": "#040404"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|base",
          "fontSize": "var:preset|font-size|sm"
        }
      },
      "core/group": {
        "spacing": {
          "blockGap": "1.5rem",
          "padding": {
            "top": "var:preset|spacing|xl",
            "right": "var:preset|spacing|xl",
            "bottom": "var:preset|spacing|xl",
            "left": "var:preset|spacing|xl"
          }
        }
      },
      "core/heading": {
        "color": {
          "text": "#ebe7dc"
        },
        "typography": {
          "fontFamily": "var:preset|font-family|heading",
          "fontWeight": "400",
          "lineHeight": "1.2"
        }
      },
      "core/list": {
        "color": {
          "text": "#d7d3c8"
        },
        "spacing": {
          "blockGap": "0.75rem"
        },
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "lineHeight": "1.72"
        }
      },
      "core/paragraph": {
        "color": {
          "text": "#d7d3c8"
        },
        "typography": {
          "fontSize": "var:preset|font-size|md",
          "lineHeight": "1.72"
        }
      },
      "core/pullquote": {
        "border": {
          "color": "#a8a8a8"
        },
        "color": {
          "text": "#ebe7dc"
        }
      },
      "core/quote": {
        "border": {
          "color": "#a8a8a8"
        },
        "color": {
          "text": "#d7d3c8"
        }
      }
    },
    "spacing": {
      "blockGap": "1.5rem"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|base",
      "fontSize": "var:preset|font-size|md",
      "lineHeight": "1.72"
    }
  }
}
